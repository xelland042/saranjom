# Matches the db service in docker-compose.yml. Development only: change it anywhere real.
# The app connects as open_erp_app, which owns no tables, so row-level security applies.
MAIN_CONFIG__DB__URL=postgresql+asyncpg://open_erp_app:open_erp_app@localhost:5432/open_erp
# Migrations run as the table owner.
MAIN_CONFIG__DB__MIGRATION_URL=postgresql+asyncpg://open_erp:open_erp@localhost:5432/open_erp
MAIN_CONFIG__DB__ECHO=0
MAIN_CONFIG__DEBUG=0
# Start Jaeger with `docker compose --profile tracing up -d`, then set to 1
MAIN_CONFIG__TRACING__ENABLED=0
